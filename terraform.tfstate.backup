  "outputs": {
    "webhook_uri_debug": {
      "value": "https://f38fc8cb-75f5-4ce0-ba78-8587bd0a63a3.webhook.cc.azure-automation.net/webhooks?token=a%2fG7PZ6nCucXy2twsSObaOCEgDk%2f8YgNVlo0s4u8SPw%3d",
